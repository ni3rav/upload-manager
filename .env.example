# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Database (docker compose: pnpm db:up → port 54321)
DATABASE_URL=postgresql://user:password@localhost:54321/next_template

# Cloudflare OAuth (create at CF Dashboard → Manage Account → OAuth clients)
# Redirect URL must be EXACTLY:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/cloudflare
# Example local: http://localhost:3000/api/auth/oauth2/callback/cloudflare
CLOUDFLARE_CLIENT_ID=placeholder-cloudflare-client-id
CLOUDFLARE_CLIENT_SECRET=placeholder-cloudflare-client-secret
# Space-separated scope IDs from the OAuth client picker (must also be enabled on the client).
# Billing scopes are usually unavailable via OAuth.
CLOUDFLARE_OAUTH_SCOPES=account-settings.read account-analytics.read workers-r2.write user-details.read
# OIDC discovery (real CF or local sim — see scripts/local-sim)
CLOUDFLARE_OAUTH_DISCOVERY_URL=https://dash.cloudflare.com/.well-known/openid-configuration
# R2 REST base (real CF or local sim — see scripts/local-sim)
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
